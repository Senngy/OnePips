// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  profilePic String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  bookings  Booking[]
  payments  Payment[]
}

enum Role {
  ADMIN
  USER
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  source    String?
  phone     String?
  status    LeadStatus @default(PENDING)
  score     Int?       @default(0)
  interests InterestType[]
  tradingYears Int?
  budgetFormation Int?
  budgetTrading Int?
  markets MarketType[]
  accountType AccountType[]
  createdAt DateTime @default(now())

  application Application?
  participants EventParticipant[]

}

enum LeadStatus {
  HOT
  MID
  COLD
  PENDING
}

enum InterestType {
  SIGNALS
  PRIVATE_COACHING
  ONE_TO_ONE
  LIVES_SUBSCRIPTION
}

enum MarketType {
  CFD
  CRYPTO
  FUTURES
}

enum AccountType {
  PERSONAL
  DEMO
  PROPFIRM
}

model Application {
  id                String   @id @default(uuid())
  leadId            String   @unique
  lead              Lead     @relation(fields: [leadId], references: [id])

  answers           Json
  score             Int
  status            ApplicationStatus

  interests         String[]
  budgetFormation   Int?
  capitalTrading    Int?

  createdAt         DateTime @default(now())
}

enum ApplicationStatus {
  NEW
  CHECKED
  QUALIFIED
  PENDING
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  date      DateTime
  status    String
  notes     String?

  createdAt DateTime @default(now())
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  amount    Float
  type      String
  status    String

  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  startsAt    DateTime
  description String?
  isPublished Boolean  @default(false)
  isCanceled  Boolean  @default(false)

  participants EventParticipant[]
  
  createdAt   DateTime @default(now())
}

model EventParticipant {
  id        String @id @default(uuid())
  eventId   String
  leadId    String
  joinedAt  DateTime? @default(now())

  event Event @relation(fields: [eventId], references: [id])
  lead Lead @relation(fields: [leadId], references: [id])
  @@unique([eventId, leadId]) 
}

model YoutubeCourse {
  id          String   @id @default(uuid())
  title       String
  description String?
  embededLink String

  createdAt   DateTime @default(now())
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  createdAt   DateTime @default(now())
}

model Result {
  id          String   @id @default(uuid())
  title       String
  image       String
  gain        Float    // +142.5%
  pair        String   // XAUUSD, EURUSD
  description String?
  date        DateTime

  isVisible   Boolean  @default(true)

  createdAt   DateTime @default(now())
}

model Testimonial {
 

  createdAt   DateTime @default(now())
}

model CommunityStat {
  id    String @id @default(uuid())
  label String
  value Int
}