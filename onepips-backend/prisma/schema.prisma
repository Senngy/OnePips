// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email         String  @unique
  emailVerified Boolean @default(false)
  name          String?

  role Role @default(VIEWER)

  sessions    Session[]
  accounts    Account[]
  permissions UserPermission[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  superAdmin SuperAdmin?
}

model Session {
  id String @id @default(uuid())

  token String @unique

  expiresAt DateTime

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  ACTIVE

  SUSPENDED

  DISABLED
}

model Account {
  id String @id @default(uuid())

  accountId  String
  providerId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  idToken      String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope    String?
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SuperAdmin {
  id String @id @default(cuid())

  singleton String @unique @default("MAIN")

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model UserPermission {
  id     String @id @default(cuid())
  userId String

  permission Permission
  granted    Boolean    @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model Verification {
  id String @id @default(uuid())

  identifier String

  value String

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(uuid())

  email String  @unique
  name  String?

  stripeCustomerId String @unique

  payments      Payment[]
  subscriptions Subscription[]
  bookings      Booking[]

  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EDITOR
  VIEWER
  CUSTOMER
}

enum Permission {
  LEADS_READ
  LEADS_WRITE
  LEADS_DELETE

  APPLICATIONS_READ
  APPLICATIONS_WRITE

  BOOKINGS_READ
  BOOKINGS_WRITE

  PAYMENTS_READ
  PAYMENTS_WRITE

  EVENTS_READ
  EVENTS_WRITE
  EVENTS_DELETE

  COMMUNITY_READ
  COMMUNITY_WRITE

  SETTINGS_MANAGE

  USERS_READ
  USERS_MANAGE

  ADMINS_MANAGE
  ROLES_MANAGE

  FILES_UPLOAD
}

model Lead {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  source          String?
  phone           String?
  status          LeadStatus     @default(PENDING)
  score           Int?           @default(0)
  interests       InterestType[]
  tradingYears    Int?
  budgetFormation Int?
  budgetTrading   Int?
  markets         MarketType[]
  accountType     AccountType[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  application Application?
  customer    Customer?

  bookings Booking[]

  participants EventParticipant[]

  @@index([status])
  @@index([createdAt])
}

enum LeadStatus {
  HOT
  MID
  COLD
  PENDING
  CONVERTED
}

enum InterestType {
  SIGNALS
  PRIVATE_COACHING
  ONE_TO_ONE
  LIVES_SUBSCRIPTION
}

enum MarketType {
  CFD
  CRYPTO
  FUTURES
}

enum AccountType {
  PERSONAL
  DEMO
  PROPFIRM
}

model Application {
  id     String @id @default(uuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id])

  answers Json
  score   Int
  status  ApplicationStatus @default(NEW)

  interests       String[]
  budgetFormation Int?
  capitalTrading  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApplicationStatus {
  NEW
  CHECKED
  QUALIFIED
  PENDING
  ACCEPTED
  REFUSED
}

model Product {
  id String @id @default(uuid())

  name        String
  description String?
  type        ProductType

  price    Int
  currency String @default("eur")

  stripeProductId String? @unique
  stripePriceId   String? @unique

  active Boolean @default(true)

  billingType BillingType

  payments      Payment[]
  subscriptions Subscription[]

  courses YoutubeCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductType {
  SUBSCRIPTION

  CALL_SERVICE

  MENTORING

  COURSE
}

model Payment {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  amount   Int
  currency String @default("eur")

  stripeInvoiceId String?
  stripeChargeId  String?

  status PaymentStatus

  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

enum PaymentStatus {
  PENDING

  SUCCESS

  FAILED

  REFUNDED
}

model Subscription {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  stripeSubscriptionId String @unique

  status SubscriptionStatus

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum SubscriptionStatus {
  ACTIVE

  TRIALING

  PAST_DUE

  CANCELED
}

enum BillingType {
  ONE_TIME

  MONTHLY

  YEARLY

  HOURLY
}

model Booking {
  id         String    @id @default(uuid())
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  calBookingId String @unique

  eventType String?
  startsAt  DateTime?
  status    BookingStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookingStatus {
  CONFIRMED

  CANCELLED

  COMPLETED
}

model Event {
  id          String   @id @default(uuid())
  title       String
  startsAt    DateTime
  description String?
  isPublished Boolean  @default(false)
  isCanceled  Boolean  @default(false)

  participants EventParticipant[]

  createdAt DateTime @default(now())
}

model EventParticipant {
  id       String    @id @default(uuid())
  eventId  String
  leadId   String
  joinedAt DateTime? @default(now())

  event Event @relation(fields: [eventId], references: [id])
  lead  Lead  @relation(fields: [leadId], references: [id])

  @@unique([eventId, leadId])
}

model YoutubeCourse {
  id          String   @id @default(uuid())
  title       String
  description String?
  embededLink String
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
}

model Result {
  id          String   @id @default(uuid())
  title       String
  image       String
  gain        Float // +142.5%
  pair        String // XAUUSD, EURUSD
  description String?
  date        DateTime

  isVisible Boolean @default(true)

  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  content   String
  rating    Int
  role      String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CommunityStat {
  id    String @id @default(uuid())
  label String
  value Int
}
