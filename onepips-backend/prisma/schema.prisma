// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {

  id String @id @default(uuid())

  email String @unique
  name String?

  role Role @default(CLIENT)

  stripeCustomerId String? @unique

  payments Payment[]
  subscriptions Subscription[]
  convertedLeads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum Role {
  ADMIN
  CLIENT
  USER
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  source    String?
  phone     String?
  status    LeadStatus @default(PENDING)
  score     Int?       @default(0)
  interests InterestType[]
  tradingYears Int?
  budgetFormation Int?
  budgetTrading Int?
  markets MarketType[]
  accountType AccountType[]
  createdAt DateTime @default(now())

  convertedUserId String?

  convertedUser User? @relation(fields: [convertedUserId], references: [id])

  application Application?

  bookings Booking[]

  participants EventParticipant[]

}

enum LeadStatus {
  HOT
  MID
  COLD
  PENDING
  CONVERTED
}

enum InterestType {
  SIGNALS
  PRIVATE_COACHING
  ONE_TO_ONE
  LIVES_SUBSCRIPTION
}

enum MarketType {
  CFD
  CRYPTO
  FUTURES
}

enum AccountType {
  PERSONAL
  DEMO
  PROPFIRM
}

model Application {
  id                String   @id @default(uuid())
  leadId            String   @unique
  lead              Lead     @relation(fields: [leadId], references: [id])

  answers           Json
  score             Int
  status            ApplicationStatus

  interests         String[]
  budgetFormation   Int?
  capitalTrading    Int?

  createdAt         DateTime @default(now())
}

enum ApplicationStatus {
  NEW
  CHECKED
  QUALIFIED
  PENDING
  ACCEPTED
  REFUSED
}

model Product {

  id String @id @default(uuid())


  name String

  description String?


  type ProductType


  price Int

  currency String @default("eur")


  stripeProductId String?

  stripePriceId String?


  active Boolean @default(true)



  payments Payment[]

  subscriptions Subscription[]


  courses YoutubeCourse[]


  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}


enum ProductType {

  SUBSCRIPTION

  COACHING

  MENTORING

  COURSE

}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String

  product Product @relation(fields: [productId], references: [id])

  amount Int

  currency String @default("eur")

  stripePaymentIntentId String? @unique

  stripeInvoiceId String?

  stripeChargeId String?

  type      String
  status PaymentStatus

  createdAt DateTime @default(now())
}

enum PaymentStatus {

  PENDING

  SUCCESS

  FAILED

  REFUNDED

}

model Subscription {


  id String @id @default(uuid())



  userId String

  user User @relation(fields: [userId], references: [id])

  productId String

  product Product @relation(fields: [productId], references: [id])



  stripeSubscriptionId String @unique



  status SubscriptionStatus



  currentPeriodStart DateTime?

  currentPeriodEnd DateTime?



  cancelAtPeriodEnd Boolean @default(false)



  createdAt DateTime @default(now())


  updatedAt DateTime @updatedAt

}



enum SubscriptionStatus {

  ACTIVE

  TRIALING

  PAST_DUE

  CANCELED

}

model Booking {


  id String @id @default(uuid())
  leadId String?
  lead Lead? @relation(fields: [leadId], references: [id])

  calBookingId String @unique

  eventType String?
  startsAt DateTime?
  status BookingStatus

  createdAt DateTime @default(now())


}


enum BookingStatus {

  CONFIRMED

  CANCELLED

  COMPLETED

}

model Event {
  id          String   @id @default(uuid())
  title       String
  startsAt    DateTime
  description String?
  isPublished Boolean  @default(false)
  isCanceled  Boolean  @default(false)

  participants EventParticipant[]
  
  createdAt   DateTime @default(now())
}

model EventParticipant {
  id        String @id @default(uuid())
  eventId   String
  leadId    String
  joinedAt  DateTime? @default(now())

  event Event @relation(fields: [eventId], references: [id])
  lead Lead @relation(fields: [leadId], references: [id])
  @@unique([eventId, leadId]) 
}

model YoutubeCourse {
  id          String   @id @default(uuid())
  title       String
  description String?
  embededLink String
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  createdAt   DateTime @default(now())
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String?
  price       Float
  createdAt   DateTime @default(now())
}

model Result {
  id          String   @id @default(uuid())
  title       String
  image       String
  gain        Float    // +142.5%
  pair        String   // XAUUSD, EURUSD
  description String?
  date        DateTime

  isVisible   Boolean  @default(true)

  createdAt   DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  content   String
  rating    Int
  role      String
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CommunityStat {
  id    String @id @default(uuid())
  label String
  value Int
}